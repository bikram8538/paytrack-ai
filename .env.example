DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paytrack"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="change-me"

# Optional: real Razorpay. Leave blank for local demo mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: Resend email.
RESEND_API_KEY=""
RESEND_FROM="PayTrack AI <billing@yourdomain.com>"

# Optional: Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="payment_reminder"
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-me"

# Optional: Twilio voice.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

REDIS_URL="redis://localhost:6379"
